# 复制为仓库根目录的 .env。Linux 使用 id -u / id -g 获取用户编号。
PICSOC_UID=10001
PICSOC_GID=10001
PICSOC_DATA_PATH=./picsoc-data
PICSOC_LIBRARY_PATH=./library
PICSOC_HOST_BIND=127.0.0.1
PICSOC_PORT=3210
PICSOC_WORKERS=1
PICSOC_SCAN_INTERVAL=300
# 硬内存上限，超出时容器可能被终止；根据大图处理需求调整。
PICSOC_MEMORY_LIMIT=512m
PICSOC_CPU_LIMIT=1.0
# 设置非空密码时，登录用户名为 picsoc。
PICSOC_PASSWORD=
# 可选 ChatGPT MCP：先配置 HTTPS 反向代理和非空 PICSOC_PASSWORD，再启用。
PICSOC_MCP_ENABLED=false
PICSOC_PUBLIC_URL=
# 独立 Bearer token 仅供支持该方式的本地/API MCP 客户端；至少 32 个 ASCII 字符。
PICSOC_MCP_TOKEN=
# 额外允许的完整 OAuth 回调地址，逗号分隔。默认已允许 ChatGPT 稳定回调。
PICSOC_MCP_REDIRECT_URIS=
